# =====================================================================
# AI Security Operations & Compliance Memory Agent Configuration
# =====================================================================

# App Settings
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Hindsight Memory Engine Configuration
# Leave blank to use embedded local biomimetic memory engine (zero config required)
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_BANK_ID=secops-org-memory
FORCE_LOCAL_HINDSIGHT=false

# LLM Provider Configuration
# Options: "auto", "gemini", "openai", "expert"
# Default is "auto": uses Gemini or OpenAI if API key provided, otherwise expert engine
LLM_PROVIDER=auto

# Google Gemini API Key (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
